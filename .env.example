# העתק לקובץ .env ומלא. הקובץ נשאר מקומי בלבד.
ANTHROPIC_API_KEY=
ORS_API_KEY=            # openrouteservice.org (חינם)
SPOTIPY_CLIENT_ID=      # developer.spotify.com/dashboard
SPOTIPY_CLIENT_SECRET=
DEFAULT_ADDRESS=טרומפלדור 4, קרית אתא

# בענן בלבד:
APP_PASSWORD=          # סיסמת כניסה לאפליקציה
SECRET_KEY=            # מחרוזת אקראית ארוכה
DATA_DIR=/data         # דיסק קבוע לטוקנים
